#include <esp_now.h> // Initalize ESP NOw protocol
#include <WiFi.h> // Initalize Wifi
#include <Adafruit_NeoPixel.h> // Initalize Built in LED use
#define BUTTON_PIN  7
#define SWITCH_PIN  5 

 Adafruit_NeoPixel pixel(1, 48, NEO_GRB + NEO_KHZ800); //LED-COUNT = 1, LED_PIN = 48, Initalize built in LED 

// MAC Addresses the ESP communicates with 
uint8_t ShootAddress[] = {0x30, 0xED, 0xA0, 0xB7, 0x59, 0x9C};
uint8_t UserAddress[] = {0x98, 0x88, 0xE0, 0x14, 0xBD, 0x0C};

// Structure example to send data: MUST MATCH RECOEVER STRUCTURE 
typedef struct struct_message {
  int id;
  int b;
} struct_message;

// ALL struct_messages handled by microcontroller are defined here 
struct_message MyData; // Temporary placeholder overwritten on each recieve
struct_message ShootData; // Sending Data
struct_message AidLock; // Sending Data
struct_message LatchData; // Recieving Data

esp_now_peer_info_t peerInfo;

void OnDataSent(const wifi_tx_info_t *tx_info, esp_now_send_status_t status){
// callback when data is sent
}
void OnDataRecv(const esp_now_recv_info_t *recv_info, const uint8_t *incomingData, int len) {
  memcpy(&LatchData, incomingData, sizeof(LatchData)); //Only recieves Latch data, so it sets it to that variable always 
}

void setup() {
  // Init Serial Monitor
  Serial.begin(115200);

 
  // Set device as a Wi-Fi Station
  WiFi.mode(WIFI_STA);

  // Init ESP-NOW
  if (esp_now_init() != ESP_OK) {
    //Add latch = nonzero or non one 
    Serial.println("Error initializing ESP-NOW");
    pixel.setPixelColor(0, pixel.Color(0,0, 255)); // if ESP now is not initalized = ESP flashes blue 
    pixel.show();
    pixel.setPixelColor(0, pixel.Color(0,0,0));
    delay(250);
    pixel.show ();
    pixel.setPixelColor(0, pixel.Color(0,0,0));
    delay(250);
    return;
  }

  // Once ESPNow is successfully Init, we will register for Send CB to get the status of Transmitted packet
  esp_now_register_send_cb(OnDataSent);

  // Once ESPNow is successfully Init, we will register for recv CB to get recv packer info
  esp_now_register_recv_cb(OnDataRecv);


  // Register peer (Shooting System)
  memcpy(peerInfo.peer_addr, ShootAddress, 6);
  //If peer is unable to register = esp will flash blue 
  peerInfo.channel = 0;  
  peerInfo.encrypt = false; // data is not encrypted 
  if (esp_now_add_peer(&peerInfo) != ESP_OK){
    //Add latch data = non sero ro non one 
    Serial.println("Failed to add peer");
    pixel.setPixelColor(0, pixel.Color(0,0, 255));
    pixel.show();
    pixel.setPixelColor(0, pixel.Color(0,0,0));
    delay(250);
    pixel.show ();
    pixel.setPixelColor(0, pixel.Color(0,0,0));
    delay(250);
    return;
  }
  esp_now_peer_info_t peerInfo = {};

  // Register Peer (User System)
  memcpy(peerInfo.peer_addr, UserAddress, 6);
  // if peer is unable to register = esp will flash blue
  peerInfo.channel = 0;  
  peerInfo.encrypt = false; // data is not encrypted  
  if (esp_now_add_peer(&peerInfo) != ESP_OK){
    // add latch data = non zero and non one
    Serial.println("Failed to add peer");
    pixel.setPixelColor(0, pixel.Color(0,0, 255));
    pixel.show();
    pixel.setPixelColor(0, pixel.Color(0,0,0));
    delay(250);
    pixel.show ();
    pixel.setPixelColor(0, pixel.Color(0,0,0));
    delay(250);
    return;
  }
 
 

  pinMode(BUTTON_PIN, INPUT_PULLUP);
  pinMode(SWITCH_PIN, INPUT_PULLUP);
  pixel.begin();
  pixel.show(); // Turn off LED initially
  
}
 
void loop() {
  
  Adafruit_NeoPixel pixel(1, 48, NEO_GRB + NEO_KHZ800); //LED_COUNT = 1, LED_PIN = 48: Sets up built in LED for void loop 
  pixel.begin();
  pixel.show(); // Turn off LED initially

  AidLock.id = 2;   // Sets id of Aid lock tag as two, allowing aid lock data to be read 
  AidLock.b = digitalRead(SWITCH_PIN); // initalizing pin for aid lock to collect values from that pin 
  ShootData.id = 1;

 if (digitalRead(BUTTON_PIN) == 0) { //if red button pressed
  ShootData.b = 1;

  
 }
 
 else {                     //if red button NOT pressed
  ShootData.b = 0;
 
  
 }

 if (LatchData.b == 0){     // if solenoid is in the right place to excecute a shot = esp will be green 
    pixel.setPixelColor(0, pixel.Color(0, 255, 0));
    pixel.show();
 
  }

 else{
    pixel.setPixelColor(0, pixel.Color(255, 0, 0)); // if not, it will be red 
    pixel.show();

  }
 
  // Send message via ESP-NOW
  esp_err_t result = esp_now_send(UserAddress, (uint8_t *) &AidLock, sizeof(AidLock));
   
  if (result == ESP_OK) { // Aid lock is sent successfully 
    Serial.println("Sent with success");
  }
  else {
    Serial.println("Error sending the data 1 "); // If error to send data = esp flashes blue 
    pixel.setPixelColor(0, pixel.Color(0,0, 255));
    pixel.show();
    pixel.setPixelColor(0, pixel.Color(0,0,0));
    delay(250);
    pixel.show ();
    pixel.setPixelColor(0, pixel.Color(0,0,0));
    delay(250);
  }

  esp_err_t result2 = esp_now_send(ShootAddress, (uint8_t *) &ShootData, sizeof(ShootData));
   
  if (result2 == ESP_OK) { //Shoot Data is sent with success 
    Serial.println("Sent with success");
  }
  else {
    Serial.println("Error sending the data 2 "); // If error to send data = esp flashes blue 
    pixel.setPixelColor(0, pixel.Color(0,0, 255));
    pixel.show();
    pixel.setPixelColor(0, pixel.Color(0,0,0));
    delay(250);
    pixel.show ();
    pixel.setPixelColor(0, pixel.Color(0,0,0));
    delay(250);
  }
Serial.println(ShootData.b);
delay(10);
}












