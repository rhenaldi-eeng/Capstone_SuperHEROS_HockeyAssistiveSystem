#include <esp_now.h>

#include <WiFi.h>

 

// ---------------- Pins ----------------

 

#define LATCH_PIN 7

 

int PUL1 = 5;

int PUL2 = 36;

int DIR1 = 16;

int DIR2 = 35;

 

// ---------------- MAC Addresses ----------------

 

uint8_t AidAddress[]  = {0x30, 0xED, 0xA0, 0xA8, 0xB8, 0xF8};

uint8_t UserAddress[] = {0x98, 0x88, 0xE0, 0x14, 0xBD, 0x0C};

 

// ---------------- Message Structure ----------------

 

typedef struct struct_message {

  int id;

  int b;

} struct_message;

 

struct_message ShootData;

struct_message LatchData;

 

// ---------------- Receive Callback ----------------

 

void OnDataRecv(const esp_now_recv_info_t *info, const uint8_t *incomingData, int len)

{

  memcpy(&ShootData, incomingData, sizeof(ShootData));

}

 

// ---------------- Send Callback ----------------

 

void OnDataSent(const wifi_tx_info_t *tx_info, esp_now_send_status_t status)

{

  if (status == ESP_NOW_SEND_SUCCESS)

  {

    Serial.println("Delivery Success");

  }

  else

  {

    Serial.println("Delivery Fail");

  }

}

 

// ---------------- Send Function ----------------

 

void sendLatchStatus()

{

  esp_now_send(AidAddress,  (uint8_t *)&LatchData, sizeof(LatchData));

  esp_now_send(UserAddress, (uint8_t *)&LatchData, sizeof(LatchData));

}

// ---------------- Motor Reload ----------------

 

void reloadMotor()

{

  while(digitalRead(LATCH_PIN) == 1)

  {

    digitalWrite(DIR1, HIGH);

    digitalWrite(DIR2, LOW);

 

    digitalWrite(PUL1, HIGH);

    digitalWrite(PUL2, HIGH);

    delayMicroseconds(750);

 

    digitalWrite(PUL1, LOW);

    digitalWrite(PUL2, LOW);

    delayMicroseconds(750);

  }

 

  for (int i = 0; i < 35; i++)

  {

    digitalWrite(DIR1, HIGH);

    digitalWrite(DIR2, LOW);

 

    digitalWrite(PUL1, HIGH);

    digitalWrite(PUL2, HIGH);

    delayMicroseconds(750);

 

    digitalWrite(PUL1, LOW);

    digitalWrite(PUL2, LOW);

    delayMicroseconds(750);

  }

 

  for (int i = 0; i < 1850; i++)

  {

    digitalWrite(DIR1, LOW);

    digitalWrite(DIR2, HIGH);

 

    digitalWrite(PUL1, HIGH);

    digitalWrite(PUL2, HIGH);

    delayMicroseconds(750);

 

    digitalWrite(PUL1, LOW);

    digitalWrite(PUL2, LOW);

    delayMicroseconds(750);

  }

}

 

// ---------------- Setup ----------------

 

void setup()

{

  Serial.begin(115200);

 

  WiFi.mode(WIFI_STA);

 

  // Initialize ESP-NOW

  if (esp_now_init() != ESP_OK)

  {

    Serial.println("ESP-NOW initialization FAILED");

    return;

  }

 

  Serial.println("ESP-NOW initialized");

 

  esp_now_register_recv_cb(OnDataRecv);

  esp_now_register_send_cb(OnDataSent);

 

  // ---------- Add Aid Peer ----------

 

  esp_now_peer_info_t peer1 = {};

 

  memcpy(peer1.peer_addr, AidAddress, 6);

  peer1.channel = 0;

  peer1.encrypt = false;

 

  if (esp_now_add_peer(&peer1) == ESP_OK)

    Serial.println("Aid peer added");

  else

    Serial.println("Failed to add Aid peer");

 

  // ---------- Add User Peer ----------

 

  esp_now_peer_info_t peer2 = {};

 

  memcpy(peer2.peer_addr, UserAddress, 6);

  peer2.channel = 0;

  peer2.encrypt = false;

 

  if (esp_now_add_peer(&peer2) == ESP_OK)

    Serial.println("User peer added");

  else

    Serial.println("Failed to add User peer");

 

  // ---------- Motor Pins ----------

 

  pinMode(PUL1, OUTPUT);

  pinMode(PUL2, OUTPUT);

  pinMode(DIR1, OUTPUT);

  pinMode(DIR2, OUTPUT);

 

  pinMode(LATCH_PIN, INPUT_PULLUP);

 

  digitalWrite(PUL1, LOW);

  digitalWrite(PUL2, LOW);

}

 

// ---------------- Main Loop ----------------

 

void loop(){

  // Update latch state

  LatchData.id = 3;

  LatchData.b = digitalRead(LATCH_PIN);

 

  sendLatchStatus();

 

  if (ShootData.b == 0 && LatchData.b == 0) //if latch engaged and shot sent

  {

    Serial.println("SHOT");

 

    // reloadMotor();   // enable when ready

  }

 

  Serial.print("Shoot command: ");

  Serial.println(ShootData.b);

 

  delay(200);   // reduced network spam

}
