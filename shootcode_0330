#include <esp_now.h>

#include <WiFi.h>

 

// ---------------- Pins ----------------

 

 

 

#define LATCH_PIN 12

 

#define FIRE_PIN 4

 

 

 

int PUL1 = 5;

 

int PUL2 = 36;

 

int DIR1 = 16;

 

int DIR2 = 35;

 

 

 

// ---------------- Message Structure ----------------

 

 

 

typedef struct struct_message {

 

  int id;

 

  int b;

 

} struct_message;


struct_message ShootData;

// ---------------- Receive Callback ----------------

 

 

 

void OnDataRecv(const esp_now_recv_info_t *info, const uint8_t *incomingData, int len)

 

{

 

  memcpy(&ShootData, incomingData, sizeof(ShootData));

 

}


// ---------------- Motor Reload ----------------

 

 

 

void reloadMotor()

 

{

  while(digitalRead(LATCH_PIN) == 1)
  {
    digitalWrite(DIR1, HIGH);
    digitalWrite(DIR2, LOW);


    digitalWrite(PUL1, HIGH);
    digitalWrite(PUL2, HIGH);
    delayMicroseconds(450);
    digitalWrite(PUL1, LOW);
    digitalWrite(PUL2, LOW);
    delayMicroseconds(450);

  }

  for (int i = 0; i < 60; i++)
  {
    digitalWrite(DIR1, HIGH);
    digitalWrite(DIR2, LOW);
    digitalWrite(PUL1, HIGH);
    digitalWrite(PUL2, HIGH);
    delayMicroseconds(450);
    digitalWrite(PUL1, LOW);
    digitalWrite(PUL2, LOW);
    delayMicroseconds(450);
  }


  for (int i = 0; i < 1700; i++)

  {
    digitalWrite(DIR1, LOW);
    digitalWrite(DIR2, HIGH);

    digitalWrite(PUL1, HIGH);
    digitalWrite(PUL2, HIGH);
    delayMicroseconds(450);

    digitalWrite(PUL1, LOW);
    digitalWrite(PUL2, LOW);
    delayMicroseconds(450);
  }

 
}

 

 

 

// ---------------- Setup ----------------

 

void setup()

 

{

 

  delay(2000);

 

  Serial.begin(115200);

 

  ShootData.b = 1;      //start shoot data off to allow panel time to connect

 

  WiFi.mode(WIFI_STA);

 

 

 

  // Initialize ESP-NOW

 

  if (esp_now_init() != ESP_OK)

 

  {

 

    Serial.println("ESP-NOW initialization FAILED");

 

    return;

 

  }

 

 

 

  Serial.println("ESP-NOW initialized");

 

 

 

  esp_now_register_recv_cb(OnDataRecv);


  // ---------- Motor Pins ----------

  pinMode(PUL1, OUTPUT);
  pinMode(PUL2, OUTPUT);
  pinMode(DIR1, OUTPUT);
  pinMode(DIR2, OUTPUT);

  pinMode(LATCH_PIN, INPUT_PULLUP);
  pinMode(FIRE_PIN, OUTPUT);


  digitalWrite(PUL1, LOW);
  digitalWrite(PUL2, LOW);

  digitalWrite(FIRE_PIN, LOW);

  while (digitalRead(LATCH_PIN) == 1){
    if (ShootData.b == 0){
      reloadMotor();
      ShootData.b =1; 
      
       }
   // delay(1000);
  }
//ShootData.b =1; 

}

 
// ---------------- Main Loop ----------------



void loop(){
  
  if (ShootData.b == 0 && digitalRead(LATCH_PIN) == 0) //if latch engaged and shot sent

  {
    Serial.println("SHOT");
    digitalWrite(FIRE_PIN, HIGH);
    delay(500);
    digitalWrite(FIRE_PIN, LOW);
    
    delay(3000);

    reloadMotor();   // enable when ready

    delay(1000);

 

  }

  delay(200);   // reduced network spam


 

 

 

 

 

}
