#include <esp_now.h> // Initalize EPS NOW Protocol 
#include <WiFi.h> // Initialize wifi 
#include <Adafruit_NeoPixel.h> // Initalize Built in LED use 

 Adafruit_NeoPixel pixel(1, 48, NEO_GRB + NEO_KHZ800); //LED-COUNT = 1, LED_PIN = 48, Initalize Built in ESP LED

// MAC Addresses it communicates with 
uint8_t ShootAddress[] = {0x30, 0xED, 0xA0, 0xB7, 0x59, 0x9C};
uint8_t AidAddress[] = {0x30, 0xED, 0xA0, 0xA8, 0xB8, 0xF8};

// Structure message it recieves and sends: MUST MATCH RECIEVER STRUCTURE
typedef struct struct_message {
  int id;
  int b;
} struct_message;

// All struct_messages handled by microcontroller are defined here
struct_message MyData; //Temporary placeholder overwritten on each receive
struct_message ShootData; //Sending Data
struct_message AidLock; //Receiving Data
struct_message LatchData; //Recieveing Data 

esp_now_peer_info_t peerInfo;

void OnDataSent(const wifi_tx_info_t *tx_info, esp_now_send_status_t status){
} //callback when data is sent 

void OnDataRecv(const esp_now_recv_info_t *recv_info, const uint8_t *incomingData, int len) {
  memcpy(&MyData, incomingData, sizeof(MyData)); // Idneitfies packets that will be recieves 
  if (MyData.id == 2){ //Receiving from AID = ID Tag is 2 
    AidLock.b = MyData.b; // Sets the recieve data to the correct variable 
  }

  else if (MyData.id == 3){ //Receiving from SHOOTING = ID Tag is 3 
    LatchData.b = MyData.b; // Sets the recieve data to the correct variable 
  }
}

void setup() {
  Serial.begin(115200); // Initalize Serial Monitor 

  WiFi.mode(WIFI_STA); // Set device as Wifi Station 

  // Init ESP-NOW and checks if it connects 
  if (esp_now_init() != ESP_OK) {
    //Add latch data = nonzero or one
    Serial.println("Error initializing ESP-NOW"); //if ESP now is not initalized = flashhing blue will occur 
    pixel.setPixelColor(0, pixel.Color(0,0, 255));
    pixel.show();
    pixel.setPixelColor(0, pixel.Color(0,0,0));
    delay(250);
    pixel.show ();
    pixel.setPixelColor(0, pixel.Color(0,0,0));
    delay(250); 
    return;
  }

  // Once ESPNow is successfully Initalized, we will register for Send CB to get the status of Transmitted packet
  esp_now_register_send_cb(OnDataSent);

  // Once ESPNow is successfully Init, we will register for recv CB to get recv packer info
  esp_now_register_recv_cb(OnDataRecv);

  // Register peer
  memcpy(peerInfo.peer_addr, ShootAddress, 6);
  peerInfo.channel = 0;  
  peerInfo.encrypt = false;

  // If peer is unable to be added = esp flashes blue        
  if (esp_now_add_peer(&peerInfo) != ESP_OK){
    //Add latch data = nonzero or one
    Serial.println("Failed to add peer");
    pixel.setPixelColor(0, pixel.Color(0,0, 255));
    pixel.show();
    pixel.setPixelColor(0, pixel.Color(0,0,0));
    delay(250);
    pixel.show ();
    pixel.setPixelColor(0, pixel.Color(0,0,0));
    delay(250); 
    return;
  }
  pinMode(18, OUTPUT); // Sets up the power pin for button 
  digitalWrite(18, HIGH); // Sends high power to button 
  pinMode(7, INPUT); // Sets up button pin 
}
 

void loop() {
  
  Adafruit_NeoPixel pixel(1, 48, NEO_GRB // Sets up the use of the built in LED in void loop 
 + NEO_KHZ800); //LED-COUNT = 1, LED_PIN = 48
  pixel.begin();
  pixel.show(); 

  if (digitalRead(7) == HIGH){   //If big red button pressed
    ShootData.b = 1;
   
  }
  else{                           //if red button NOT pressed
    ShootData.b = 0;
 
  
  }

  if (LatchData.b == 0){                            // If solenoid is in place then LED will be green, indicating a shot can be taken 
    pixel.setPixelColor(0, pixel.Color(0,255, 0));
    pixel.show();
  }

  else{                                             // If solenoid is not in place and shot cannot be taken, the LED will be red 
    pixel.setPixelColor(0, pixel.Color(255,0, 0));
    pixel.show();
  }

  if(AidLock.b == LOW){                             // If aid lock on aid panel is off, then shots can be transmitted from user panel 
    esp_err_t result = esp_now_send(ShootAddress, (uint8_t *) &ShootData, sizeof(ShootData));
    if (result == ESP_OK) {
      Serial.println("Sent with success");
      }
    else {                                        // If error to send data = esp flashes blue 
      Serial.println("Error sending the data");
      //Add latch data = nonzero or one
      pixel.setPixelColor(0, pixel.Color(0,0, 255));
      pixel.show();
      pixel.setPixelColor(0, pixel.Color(0,0,0));
      delay(250);
      pixel.show ();
      pixel.setPixelColor(0, pixel.Color(0,0,0));
      delay(250);
      }
  Serial.println(ShootData.b);
  }
}





